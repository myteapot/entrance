{
  "appId": "com.entrance.desktop",
  "productName": "Entrance",
  "artifactName": "Entrance-${version}-${os}-${arch}.${ext}",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "src-tauri/target/release/entrance",
      "to": "entrance"
    }
  ],
  "linux": {
    "target": [
      {
        "target": "rpm",
        "arch": [
          "x64"
        ]
      }
    ],
    "category": "Development",
    "maintainer": "Entrance Maintainers <maintainers@entrance.local>",
    "icon": "src-tauri/icons"
  }
}
