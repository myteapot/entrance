{
  "name": "entrance",
  "version": "1.0.0-rc.1",
  "private": true,
  "homepage": "http://server:9311/publish/entrance",
  "author": {
    "name": "Entrance Maintainers",
    "email": "maintainers@entrance.local"
  },
  "description": "Entrance V1 release candidate runtime shell powered by Tauri 2 and SolidJS",
  "main": "hosts/desktop/electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite --config surfaces/gui/vite.config.ts",
    "dev:electron": "node hosts/desktop/electron/dev.mjs",
    "build": "pnpm check && vite build --config surfaces/gui/vite.config.ts",
    "start:electron": "electron hosts/desktop/electron/main.mjs",
    "build:electron:prereq": "pnpm check && vite build --config surfaces/gui/vite.config.ts && cargo build --manifest-path hosts/desktop/tauri/Cargo.toml --release --bin entrance",
    "build:electron:rpm": "bash hosts/release/build-electron-rpm.sh rpm",
    "build:electron:dir": "bash hosts/release/build-electron-rpm.sh dir",
    "test:electron-smoke": "node hosts/release/electron-smoke.mjs",
    "preview": "vite preview --config surfaces/gui/vite.config.ts",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "tauri": "tauri -c hosts/desktop/tauri/tauri.conf.json",
    "test:e2e": "npx playwright test -c hosts/desktop/browser/playwright.config.ts",
    "test:e2e:headed": "npx playwright test -c hosts/desktop/browser/playwright.config.ts --headed"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@solidjs/router": "^0.16.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.10.0",
    "d3-force": "^3.0.0",
    "d3-timer": "^3.0.1",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "playwright": "^1.59.1",
    "@tauri-apps/cli": "^2",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.0.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.0.12",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
